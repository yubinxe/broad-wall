{
  "cleanUrls": false,
  "headers": [
    {
      "source": "/((?!classic/).*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/classic",
      "destination": "https://invest-helper-gt4i3j1ra-yubin-ki-m-s-projects.vercel.app/",
      "permanent": false
    },
    {
      "source": "/classic/",
      "destination": "https://invest-helper-gt4i3j1ra-yubin-ki-m-s-projects.vercel.app/",
      "permanent": false
    },
    {
      "source": "/classic/:path+",
      "destination": "https://invest-helper-gt4i3j1ra-yubin-ki-m-s-projects.vercel.app/:path+",
      "permanent": false
    }
  ],
  "buildCommand": "mkdir -p data && node scripts/build-data.mjs",
  "outputDirectory": ".",
  "installCommand": ""
}
